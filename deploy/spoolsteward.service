[Unit]
Description=SpoolSteward (authentication, quotas, audit for IPP printing)
Documentation=file:///opt/spoolsteward/README.md
After=network-online.target cups.service
Wants=network-online.target
Requires=cups.service

[Service]
Type=simple
User=spoolsteward
Group=spoolsteward
EnvironmentFile=/etc/spoolsteward/env
ExecStart=/opt/spoolsteward/venv/bin/spoolsteward
Restart=on-failure
RestartSec=3
# /var/lib/spoolsteward, owned by the service user
StateDirectory=spoolsteward
StateDirectoryMode=0750
UMask=0077

# port 631 is privileged
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
