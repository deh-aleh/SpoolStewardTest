# /etc/spoolsteward/env   (root:spoolsteward, mode 0640 -- it holds secrets)
# Every setting is SPOOLSTEWARD_<NAME>; see spoolsteward/config.py for the full list.

# --- listener -------------------------------------------------------------
SPOOLSTEWARD_HOST=0.0.0.0
SPOOLSTEWARD_PORT=631
SPOOLSTEWARD_TLS_CERTFILE=/etc/spoolsteward/tls/fullchain.pem
SPOOLSTEWARD_TLS_KEYFILE=/etc/spoolsteward/tls/privkey.pem

# --- CUPS backend (see docker/stack/cups/cupsd.conf) ---------------------------------
SPOOLSTEWARD_CUPS_URL=unix:///run/cups/cups.sock

# --- storage --------------------------------------------------------------
# SQLite only: one file, no database server.
SPOOLSTEWARD_DATABASE_URL=sqlite:////var/lib/spoolsteward/spoolsteward.db

# --- authentication (RADIUS) ----------------------------------------------
SPOOLSTEWARD_RADIUS_HOST=192.0.2.10
SPOOLSTEWARD_RADIUS_PORT=1812
SPOOLSTEWARD_RADIUS_SECRET=change-me
SPOOLSTEWARD_RADIUS_TIMEOUT=5
# successful logins are cached this long, so changes/disabling in RADIUS apply within this window
SPOOLSTEWARD_AUTH_CACHE_SECONDS=60
# users unknown to the gateway are created at first login in this group (false = admins pre-register users)
SPOOLSTEWARD_AUTO_CREATE_USERS=true
SPOOLSTEWARD_DEFAULT_GROUP=default

# --- admin portal ---------------------------------------------------------
# signs session cookies; generated by install.sh. Rotating it logs every admin out.
SPOOLSTEWARD_SECRET_KEY=__GENERATED__

# --- misc -----------------------------------------------------------------
# time zone of quota periods and of the times shown; CHANGE it to yours (for example Europe/Rome)
SPOOLSTEWARD_TIMEZONE=UTC
# language of the portal for visitors whose browser does not say (and for users who did not pick one): en it es ru zh
SPOOLSTEWARD_LANGUAGE=en
SPOOLSTEWARD_RECONCILE_INTERVAL=30
SPOOLSTEWARD_LOG_LEVEL=INFO

# --- accounts (added with the personal print keys) -----------------------------
# RADIUS is optional: leave SPOOLSTEWARD_RADIUS_HOST / SPOOLSTEWARD_RADIUS_SECRET out (or write none in both) for local accounts only.
# A setting is never written empty: a value, or none where the setting may be unset (see docker/env.example).
# keys = clients print with a personal key made in the portal (recommended); keys+radius = also the RADIUS password.
SPOOLSTEWARD_IPP_AUTH=keys
SPOOLSTEWARD_KEY_TTL_DAYS_RADIUS=90
SPOOLSTEWARD_KEY_TTL_DAYS_LOCAL=365
# first-run administrator: the one-time code is printed in the service log (journalctl -u spoolsteward | grep "FIRST RUN")
SPOOLSTEWARD_BOOTSTRAP_ADMIN=true
SPOOLSTEWARD_BOOTSTRAP_ADMIN_USERNAME=administrator
# audit archive: compressed files, kept forever, in this folder (must be writable by the service user)
SPOOLSTEWARD_AUDIT_MAX_MB=50
SPOOLSTEWARD_AUDIT_ARCHIVE_DIR=/var/lib/spoolsteward/audit-archive
# login lock-out kept across restarts (the default /data exists only in the docker image)
SPOOLSTEWARD_LOCKOUT_FILE=/var/lib/spoolsteward/login-lockout.json
