msgid "Applies to all users, also to the accounts of the administrator group"
msgstr "Действует для всех пользователей, в том числе для учётных записей группы administrator"

#: spoolsteward/admin/templates/printers.html:137
msgid "BLOCKED FOR EVERYONE · admins included"
msgstr "ЗАБЛОКИРОВАН ДЛЯ ВСЕХ · включая администраторов"

#: spoolsteward/admin/templates/printers.html:138
msgid "It is not announced on the network: still usable by whoever knows it"
msgstr "Не анонсируется в сети: пользоваться ею по-прежнему может тот, кто о ней знает"

#: spoolsteward/admin/templates/printers.html:138
