#: spoolsteward/admin/templates/_own_notices.html:3
#: spoolsteward/admin/templates/_own_notices.html:7
#: spoolsteward/admin/templates/notices.html:17
#: spoolsteward/admin/templates/notices.html:21
msgid "What happened"
msgstr "Что произошло"

#: spoolsteward/admin/templates/_own_notices.html:9
#, python-format
msgid "An administrator revoked your print key “%(label)s” (starts with %(prefix)s). It no longer works: create another one in your profile if you need it."
msgstr "Администратор отозвал ваш ключ печати «%(label)s» (начинается с %(prefix)s). Он больше не работает: при необходимости создайте другой в своём профиле."

#: spoolsteward/admin/templates/_own_notices.html:11
#, python-format
msgid "An administrator revoked ALL your print keys (%(n)s). They no longer work: create new ones in your profile if you need them."
msgstr "Администратор отозвал ВСЕ ваши ключи печати (%(n)s). Они больше не работают: при необходимости создайте новые в своём профиле."

#: spoolsteward/admin/templates/_own_notices.html:13
#, python-format
msgid "An administrator switched off your print key “%(label)s” (starts with %(prefix)s). It does not work for now, and its expiry date does not change."
msgstr "Администратор отключил ваш ключ печати «%(label)s» (начинается с %(prefix)s). Сейчас он не работает, а срок его действия не меняется."

#: spoolsteward/admin/templates/_own_notices.html:15
#, python-format
msgid "An administrator switched your print key “%(label)s” (starts with %(prefix)s) back on. It works again."
msgstr "Администратор снова включил ваш ключ печати «%(label)s» (начинается с %(prefix)s). Он снова работает."

#: spoolsteward/admin/templates/_own_notices.html:17
#, python-format
msgid "An administrator extended your print key “%(label)s” (starts with %(prefix)s). It now expires on %(date)s."
msgstr "Администратор продлил ваш ключ печати «%(label)s» (начинается с %(prefix)s). Теперь он действует до %(date)s."

#: spoolsteward/admin/templates/_own_notices.html:19
#, python-format
msgid "Your print key “%(label)s” (starts with %(prefix)s) expires on %(date)s. Create a new one before then and set it up on your devices."
msgstr "Ваш ключ печати «%(label)s» (начинается с %(prefix)s) истекает %(date)s. Создайте новый до этой даты и настройте его на своих устройствах."

#: spoolsteward/admin/templates/_own_notices.html:21
#, python-format
msgid "An administrator moved you from the group “%(old)s” to the group “%(new)s”. Your limits are now those of the new group."
msgstr "Администратор перевёл вас из группы «%(old)s» в группу «%(new)s». Теперь у вас лимиты новой группы."

#: spoolsteward/admin/templates/_own_notices.html:23
msgid "An administrator made you an administrator. You can now manage users, groups and printers: the menu at the top has the new pages."
msgstr "Администратор сделал вас администратором. Теперь вы можете управлять пользователями, группами и принтерами: новые страницы есть в верхнем меню."

#: spoolsteward/admin/templates/_own_notices.html:25
#, python-format
msgid "An administrator removed your administrator rights. You are now in the group “%(group)s”."
msgstr "Администратор лишил вас прав администратора. Теперь вы в группе «%(group)s»."

#: spoolsteward/admin/templates/_own_notices.html:27
#, python-format
msgid "An administrator gave you a permission: %(what)s, %(when)s."
msgstr "Администратор выдал вам разрешение: %(what)s, %(when)s."

#: spoolsteward/admin/templates/_own_notices.html:27
#: spoolsteward/admin/templates/_own_notices.html:38
#, python-format
msgid "until the end of %(date)s"
msgstr "до конца дня %(date)s"

#: spoolsteward/admin/templates/_own_notices.html:27
#: spoolsteward/admin/templates/_own_notices.html:38
msgid "with no end date"
msgstr "без срока окончания"

#: spoolsteward/admin/templates/_own_notices.html:27
#: spoolsteward/admin/templates/_own_notices.html:33
#: spoolsteward/admin/templates/_own_notices.html:39
#: spoolsteward/admin/templates/_own_notices.html:41
#, python-format
msgid "Note: %(note)s"
msgstr "Примечание: %(note)s"

#: spoolsteward/admin/templates/_own_notices.html:29
#, python-format
msgid "An administrator withdrew the permission you had been given: %(what)s."
msgstr "Администратор отозвал выданное вам разрешение: %(what)s."

#: spoolsteward/admin/templates/_own_notices.html:31
#, python-format
msgid "The permission you had been given has ended: %(what)s. You can ask for it again from your profile."
msgstr "Срок выданного вам разрешения истёк: %(what)s. Вы можете запросить его снова в своём профиле."

#: spoolsteward/admin/templates/_own_notices.html:33
#, python-format
msgid "An administrator gave you extra quota: %(amount)s %(metric)s, %(scope)s."
msgstr "Администратор выдал вам дополнительную квоту: %(amount)s %(metric)s, %(scope)s."

#: spoolsteward/admin/templates/_own_notices.html:35
#, python-format
msgid "An administrator withdrew your extra quota of %(amount)s %(metric)s."
msgstr "Администратор отозвал вашу дополнительную квоту: %(amount)s %(metric)s."

#: spoolsteward/admin/templates/_own_notices.html:37
#, python-format
msgid "Your request to change group was approved: you are now in the group “%(group)s”."
msgstr "Ваш запрос на смену группы одобрен: теперь вы в группе «%(group)s»."

#: spoolsteward/admin/templates/_own_notices.html:38
#, python-format
msgid "Your request for a permission was approved: %(what)s, %(when)s."
msgstr "Ваш запрос на разрешение одобрен: %(what)s, %(when)s."

#: spoolsteward/admin/templates/_own_notices.html:39
#, python-format
msgid "Your request for more quota was approved: %(amount)s %(metric)s, %(scope)s."
msgstr "Ваш запрос на увеличение квоты одобрен: %(amount)s %(metric)s, %(scope)s."

#: spoolsteward/admin/templates/_own_notices.html:41
#, python-format
msgid "Your request for a permission was rejected: %(what)s."
msgstr "Ваш запрос на разрешение отклонён: %(what)s."

#: spoolsteward/admin/templates/_own_notices.html:41
msgid "Your request was rejected."
msgstr "Ваш запрос отклонён."

#: spoolsteward/admin/templates/_own_notices.html:44
#, python-format
msgid "The printer “%(printer)s” has a paper jam, and your print is waiting. Somebody has to clear it; the print will go on by itself."
msgstr "В принтере «%(printer)s» замятие бумаги, ваша печать ждёт. Кто-то должен устранить замятие; печать продолжится сама."

#: spoolsteward/admin/templates/_own_notices.html:45
#, python-format
msgid "The printer “%(printer)s” is out of paper (or the tray is empty), and your print is waiting. When paper is loaded the print will go on by itself."
msgstr "В принтере «%(printer)s» закончилась бумага (или лоток пуст), ваша печать ждёт. Когда бумагу загрузят, печать продолжится сама."

#: spoolsteward/admin/templates/_own_notices.html:46
#, python-format
msgid "The printer “%(printer)s” is out of ink or toner, and your print may not come out right or may stop. Tell whoever looks after the printer."
msgstr "В принтере «%(printer)s» закончились чернила или тонер, печать может получиться плохой или остановиться. Сообщите тому, кто отвечает за принтер."

#: spoolsteward/admin/templates/_own_notices.html:47
#, python-format
msgid "The printer “%(printer)s” reports a problem, and your print is waiting."
msgstr "Принтер «%(printer)s» сообщает о проблеме, ваша печать ждёт."

#: spoolsteward/admin/templates/_own_notices.html:49
msgid "An administrator changed what you may print (colour, one-sided prints, printers or hours). Your profile shows your permissions."
msgstr "Администратор изменил, что вы можете печатать (цвет, односторонняя печать, принтеры или часы). Ваши разрешения показаны в профиле."

#: spoolsteward/admin/templates/_own_notices.html:52
#, python-format
msgid "Your print to “%(printer)s” was refused: your account is not allowed to use that printer. Your profile shows the printers you can use."
msgstr "Ваша печать на «%(printer)s» отклонена: вашей учётной записи нельзя использовать этот принтер. В профиле показаны принтеры, которые вам доступны."

#: spoolsteward/admin/templates/_own_notices.html:53
#, python-format
msgid "Your print to “%(printer)s” was refused: printing is allowed only %(window)s."
msgstr "Ваша печать на «%(printer)s» отклонена: печатать можно только %(window)s."

#: spoolsteward/admin/templates/_own_notices.html:53
#, python-format
msgid "Your print to “%(printer)s” was refused: printing is not allowed at this hour."
msgstr "Ваша печать на «%(printer)s» отклонена: в это время печатать нельзя."

#: spoolsteward/admin/templates/_own_notices.html:54
#, python-format
msgid "Your print to “%(printer)s” was refused: colour printing is not allowed for your account. Choose black and white in the print window and send it again."
msgstr "Ваша печать на «%(printer)s» отклонена: цветная печать вашей учётной записи недоступна. Выберите чёрно-белую печать в окне печати и отправьте снова."

#: spoolsteward/admin/templates/_own_notices.html:55
#, python-format
msgid "Your print to “%(printer)s” was refused: one-sided printing is not allowed for your account. Choose double-sided in the print window and send it again."
msgstr "Ваша печать на «%(printer)s» отклонена: односторонняя печать вашей учётной записи недоступна. Выберите двустороннюю печать в окне печати и отправьте снова."

#: spoolsteward/admin/templates/_own_notices.html:56
#, python-format
msgid "Your print to “%(printer)s” was refused."
msgstr "Ваша печать на «%(printer)s» отклонена."

#: spoolsteward/admin/templates/_own_notices.html:59
#, python-format
msgid "Your print to “%(printer)s” was refused: the %(period)s %(noun)s limit is reached (%(used)s/%(limit)s). You can ask for more quota from your profile."
msgstr "Печать на «%(printer)s» отклонена: достигнут лимит (%(noun)s, %(period)s): %(used)s/%(limit)s. Можно запросить больше квоты в профиле."

#: spoolsteward/admin/templates/_own_notices.html:62
#, python-format
msgid "Your print to “%(printer)s” was made in black and white: colour printing is not allowed for your account."
msgstr "Ваша печать на «%(printer)s» выполнена в чёрно-белом режиме: цветная печать вашей учётной записи недоступна."

#: spoolsteward/admin/templates/_own_notices.html:62
#, python-format
msgid "Your print to “%(printer)s” was made double-sided: one-sided printing is not allowed for your account."
msgstr "Ваша печать на «%(printer)s» выполнена в двустороннем режиме: односторонняя печать вашей учётной записи недоступна."

#: spoolsteward/admin/templates/_own_notices.html:64
#, python-format
msgid "Scan refused: the window was for %(expected)s, the request comes from %(got)s. Open the portal from the device that scans, or see the scanning help in the user guide."
msgstr "Сканирование отклонено: окно было открыто для %(expected)s, а запрос пришёл с %(got)s. Откройте портал с устройства, которое сканирует, или прочитайте раздел о сканировании в руководстве пользователя."

#: spoolsteward/admin/templates/_own_notices.html:66
#, python-format
msgid "The printer “%(old)s” is now called “%(new)s”. If you had set it up by hand on a computer or phone with the old address, set it up again with the new name."
msgstr "Принтер «%(old)s» теперь называется «%(new)s». Если вы настраивали его вручную на компьютере или телефоне по старому адресу, настройте его заново с новым именем."

#: spoolsteward/admin/templates/_own_notices.html:68
msgid "The gateway is in maintenance: printing and scanning are suspended for now. You will be able to use them again when an administrator ends the maintenance."
msgstr "Шлюз находится на обслуживании: печать и сканирование временно приостановлены. Вы сможете пользоваться ими снова, когда администратор завершит обслуживание."

#: spoolsteward/admin/templates/_own_notices.html:70
msgid "The maintenance is over: printing and scanning work again."
msgstr "Обслуживание завершено: печать и сканирование снова работают."

#: spoolsteward/admin/templates/_own_notices.html:72
#: spoolsteward/admin/templates/notices.html:45
msgid "<b>Save the secret key in a safe place.</b> <span class=\"mono\">SPOOLSTEWARD_SECRET_KEY</span> in the <span class=\"mono\">.env</span> file encrypts the file names kept in the audit and signs the portal sessions. A backup without encryption does not contain it: if the server breaks and you restore the backup with a new key, the names stay unreadable (<span class=\"mono\">[encrypted]</span>) for good. Copy the line from <span class=\"mono\">.env</span> into a password manager, or make encrypted backups (they include <span class=\"mono\">.env</span>)."
msgstr "<b>Сохраните секретный ключ в надёжном месте.</b> <span class=\"mono\">SPOOLSTEWARD_SECRET_KEY</span> в файле <span class=\"mono\">.env</span> шифрует имена файлов в аудите и подписывает сеансы портала. Резервная копия без шифрования его не содержит: если сервер сломается и вы восстановите копию с новым ключом, имена навсегда останутся нечитаемыми (<span class=\"mono\">[encrypted]</span>). Скопируйте строку из <span class=\"mono\">.env</span> в менеджер паролей или делайте зашифрованные копии (они включают <span class=\"mono\">.env</span>)."

