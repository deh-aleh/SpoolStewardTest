#: spoolsteward/escl.py:576
msgid "Scanning is not enabled on this server"
msgstr "Сканирование не включено на этом сервере"

#: spoolsteward/escl.py:583
#, python-format
msgid "%(reason)s. You can ask for more quota from your profile."
msgstr "%(reason)s. Вы можете запросить больше квоты в своём профиле."

#: spoolsteward/escl.py:596
msgid "This scanner has no automatic feeder"
msgstr "У этого сканера нет автоподатчика"

#: spoolsteward/escl.py:596
msgid "Source not available"
msgstr "Источник недоступен"

#: spoolsteward/escl.py:598
#, python-format
msgid "With the feeder the maximum quality is %(n)s dpi"
msgstr "С автоподатчиком максимальное качество — %(n)s dpi"

#: spoolsteward/escl.py:599
#, python-format
msgid "With the glass the maximum quality is %(n)s dpi"
msgstr "Со стеклом максимальное качество — %(n)s dpi"

#: spoolsteward/escl.py:613
msgid "The feeder is empty or the scanner was paused: remove and reload the sheets, then try again."
msgstr "Автоподатчик пуст или сканер был приостановлен: выньте и снова вложите листы, затем повторите попытку."

#: spoolsteward/escl.py:614
msgid "The scanner is busy: try again in a few seconds."
msgstr "Сканер занят: повторите попытку через несколько секунд."

#: spoolsteward/escl.py:615
#, python-format
msgid "The scanner refused the job (status %(code)s). %(hint)s"
msgstr "Сканер отклонил задание (статус %(code)s). %(hint)s"

#: spoolsteward/escl.py:618
msgid "Unexpected answer from the scanner"
msgstr "Неожиданный ответ сканера"

#: spoolsteward/escl.py:625
msgid "The scanner delivered no page"
msgstr "Сканер не выдал ни одной страницы"

#: spoolsteward/escl.py:629
msgid "The scanner does not answer"
msgstr "Сканер не отвечает"

#: spoolsteward/escl.py:666
msgid "in progress"
msgstr "выполняется"

#: spoolsteward/escl.py:666
msgid "ready"
msgstr "готово"

#: spoolsteward/escl.py:666
msgid "unsuccessful"
msgstr "не удалось"

#: spoolsteward/escl.py:670
#, python-format
msgid "scan-%(stamp)s"
msgstr "скан-%(stamp)s"

#: spoolsteward/escl.py:698
msgid "Unexpected error during the scan"
msgstr "Непредвиденная ошибка при сканировании"

#: spoolsteward/escl.py:742
msgid "The server can not tell which address you are connecting from."
msgstr "Сервер не может определить, с какого адреса вы подключаетесь."

#: spoolsteward/escl.py:745
msgid "Too many scan windows are open: try again in a few minutes."
msgstr "Открыто слишком много окон сканирования: повторите через несколько минут."

#: spoolsteward/escl.py:768
#, python-format
msgid "The scanner “%(name)s” does not answer: refresh the page."
msgstr "Сканер «%(name)s» не отвечает: обновите страницу."

#: spoolsteward/escl.py:768
msgid "No scanner available."
msgstr "Нет доступных сканеров."

#: spoolsteward/escl.py:775
#, python-format
msgid "%(name)s is already scanning: wait for it to finish."
msgstr "%(name)s уже сканирует: дождитесь окончания."

