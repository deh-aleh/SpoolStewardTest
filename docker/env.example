# =====================================================================================================================
#  .env  --  ALL THE SETTINGS OF SPOOLSTEWARD, in one file
# =====================================================================================================================
#
#  Part A (first) is for docker compose: which version runs, the Linux user, the port, the printers.
#  Part B (after it) is for the program itself: login, quotas, backups, language... Every one is called SPOOLSTEWARD_<NAME>;
#  the full official list with the defaults is in spoolsteward/config.py.
#
#  How this file is made: scripts/docker-init.sh copies docker/env.example to .env, writes your user id and the folder
#  in it, creates a random SPOOLSTEWARD_SECRET_KEY and sets the permissions to 600 (only you can read it: it holds secrets).
#
#  After every change, run:       docker compose up -d        (it recreates the containers that use this file)
#
#  Rules of the file:
#   * A line starting with "#" is a comment. A line you do not write takes its default. "NAME=" with nothing after it
#     stops the start: to leave an optional setting unset write none (the comment of each setting says when it may be none).
#   * A value with spaces, "$" or "#" in it goes between single quotes:  SPOOLSTEWARD_RADIUS_SECRET='my$secret #1'
#     (docker compose would otherwise read "$" as the start of a variable).
#   * You never have to edit docker-compose.yml: everything you may change is here.
#
#  When you update SpoolSteward this file is NEVER changed. A new version can bring new options: they work with their
#  default value without being here. To see them, compare this file with docker/env.example of the new version
#  (it is replaced by every update) and copy the ones you want to change:
#       diff <(grep -o '^#\?[A-Z_]*=' docker/env.example | sort) <(grep -o '^#\?[A-Z_]*=' .env | sort)
#

# =====================================================================================================================
#  PART A.  HOW THE CONTAINERS ARE STARTED (docker compose)
# =====================================================================================================================
# --- Which version runs ----------------------------------------------------------------------------------------------
# Where the ready-made images are downloaded from, and which version. Do not change by hand:
# use scripts/update.sh to update (it makes a backup first and goes back if the new version does not start).
# Building the images from the source code is for developers: see CONTRIBUTING.md in the source repository.
SPOOLSTEWARD_REGISTRY=ghcr.io/deh-aleh
SPOOLSTEWARD_VERSION=__VERSION__

# --- Your Linux user -------------------------------------------------------------------------------------------------
# The gateway runs as this user, so it can read the TLS key and write in data/. Filled in for you; no need to change.
PUID=__PUID__
PGID=__PGID__

# --- Optional: update from the portal --------------------------------------------------------------------------------
# Full path of this folder. Only used by the optional "updater" container (docker compose --profile autoupdate up -d).
PROJECT_DIR=__PROJECT_DIR__

# --- Network ---------------------------------------------------------------------------------------------------------
# TCP port people connect to (https://<server>:PORT). Change it if 8631 is already used.
PORTAL_PORT=8631

# --- Printers --------------------------------------------------------------------------------------------------------
# Printers created in CUPS at start, as "NAME=ADDRESS", separated by spaces. Each one is created ONCE: if you delete the
# queue later (or a USB printer stays away and the gateway removes it), it does not come back at the next start.
# To bring one back: scripts/queue-restore.sh NAME --reboot.
# USB printers do not need to be listed: they are found by themselves. List one only to give it a fixed name. Examples:
#   network printer:  CUPS_QUEUES="OFFICE=ipp://192.168.1.60/ipp/print"
#   USB printer:      CUPS_QUEUES=HP7305=ipp://ipp-usb:60000/ipp/print
CUPS_QUEUES=none
# 1 = also create a test queue that writes PDF files instead of printing (to try quotas without paper). Use 0 in production.
CUPS_VIRTUAL_QUEUE=0

# --- Certificate synchronisation (optional) --------------------------------------------------------------------------
# Only for scripts/cert-sync.sh: it copies the TLS certificate from the machine that renews it (Nginx Proxy Manager,
# certbot...) into config/tls and restarts the gateway when it changed. Run it from cron (see docs/en/certificates.md).
# Leave all of this commented out if you do not use it.
# CERT_SYNC_HOST=npm.example.lan
# CERT_SYNC_USER=certsync
# CERT_SYNC_KEY=/home/you/.ssh/spoolsteward_certsync
# Full path, on that machine, of the folder that holds the two files. Nginx Proxy Manager: .../data/letsencrypt/live/npm-3
# (or .../data/custom_ssl/npm-3); certbot: /etc/letsencrypt/live/yourdomain.
# CERT_SYNC_REMOTE_DIR=/home/you/npm/data/letsencrypt/live/npm-3
# CERT_SYNC_PORT=22
# CERT_SYNC_CERT_FILE=fullchain.pem
# CERT_SYNC_KEY_FILE=privkey.pem

# --- Where files appear on this machine ------------------------------------------------------------------------------
# Folder of the compressed audit files. Only shown in the portal, so people know where to find them.
AUDIT_ARCHIVE_HOST_PATH=__PROJECT_DIR__/data/audit-archive
# Folder of the backups. Only shown in the portal. To save on a USB disk or a network share, mount it INSIDE this folder.
BACKUP_HOST_PATH=__PROJECT_DIR__/data/backups

# =====================================================================================================================
#  PART B.  SETTINGS OF THE PROGRAM (SPOOLSTEWARD_*)
# =====================================================================================================================
#  Two containers read these: "gateway" (the real program) and "mdns" (the network announcer).
#  Anything you do not write here has a sensible default (in the image, or in spoolsteward/config.py).
#
# ---------------------------------------------------------------------------------------------------------------------
#  HOW THE PIECES FIT (helps to understand what each setting below is about)
# ---------------------------------------------------------------------------------------------------------------------
#
#    PC / phone ──ipps (TLS)──▶  GATEWAY :8631 ──unix socket──▶  CUPS ──internal network──▶  IPP-USB ──USB cable──▶ printer
#                                  │   │  ▲                                  (no port is published)
#                                  │   │  └── web portal /me and /admin (same port 8631)
#                                  │   └────▶ SQLite database (volume "portal-data"): users, groups, quotas, audit
#                                  └────────▶ your office RADIUS server (OPTIONAL): checks the passwords
#
#    MDNS (host network) ── reads the list of queues from CUPS and announces them on the LAN (Bonjour/AirPrint/Mopria),
#                           so phones and computers find the printers by themselves, without typing addresses.
#
#  * GATEWAY is the ONLY thing reachable from the network (port 8631). It checks who wants to print, applies the quotas
#    (jobs and pages per week/month), writes in the audit who printed or scanned what, and only then passes the job to CUPS.
#    It decides who the user is: the name sent by the client is never trusted.
#  * CUPS is PRIVATE: it only talks on a unix socket shared with the gateway. Nobody can reach it from the network.
#  * IPP-USB turns a USB printer into a network printer (IPP, and eSCL for scanning) visible only inside the
#    internal docker network. It needs exclusive use of the USB device.
#  * MDNS is a separate container because multicast does not cross the docker "bridge" network: it must use the host network.
#    It cannot read the database: it asks the gateway what to announce (see SPOOLSTEWARD_SECRET_KEY).
#  * The database is one SQLite file: no database server to install. Tables are updated by themselves at start (Alembic).
#
# =====================================================================================================================
#  1. SESSION SECRET  --  the most important setting to understand
# =====================================================================================================================
#
#  SPOOLSTEWARD_SECRET_KEY is a long random text that only this server knows. It is used for three things:
#
#   1) SIGNING the portal login cookie. After a login the browser gets a cookie "spoolsteward_session" that says who you are.
#      The cookie is signed with this key, so nobody can make a fake one by writing "I am admin".
#   2) PROVING who is who between "gateway" and "mdns". The announcer asks the gateway "what must I announce? is a printer
#      in maintenance? hidden? unplugged?". That answer (/mdns/policy) is protected by a code made from the key. Both
#      containers read this SAME file, so both can make the same code. Someone on the LAN without the key cannot read it.
#      WITHOUT the key the gateway answers nobody, so the announcer announces NOTHING (the answer lists the printers an
#      administrator hid): no key, no mDNS. The log of "mdns" then says what to do (docker compose logs mdns).
#   3) ENCRYPTING the file names kept in the audit (the names of the printed documents).
#
#  What it does NOT do: it does not encrypt the rest of the database, it does not encrypt print keys (they are stored only
#  as hashes) and it is nobody's password. You never type it.
#
#  If you change or lose it: all open portal sessions end (everybody logs in again) and the file names already saved can no
#  longer be read (the portal shows "[encrypted]"; putting the old key back makes them readable again). Users, print keys,
#  quotas, pages and dates do not depend on it. A backup WITHOUT encryption does not contain this key: keep a copy in a
#  password manager (the portal reminds the first administrator once, and warns if the key changes).
#  If you write none: the gateway makes a new one at EVERY start (sessions are lost at each restart), the link
#  with "mdns" is not protected and file names are stored without encryption. Always set it in production.
#
#  How to make one:  scripts/docker-init.sh writes it here in place of __GENERATED__.
#  By hand:          openssl rand -hex 32
#  At least 64 characters (what that command prints): a shorter key stops the start.
#  Never share it and never put it in a git repository. Every installation needs its own.
SPOOLSTEWARD_SECRET_KEY=__GENERATED__

# =====================================================================================================================
#  2. ACCOUNTS AND LOGIN
# =====================================================================================================================
#
#  There are two kinds of user: LOCAL (made and managed in the portal by the administrator; password stored in the
#  database as an argon2id hash) and RADIUS (your RADIUS server checks the password; the gateway never sees or stores it).
#  The kind is fixed on the user's row in the database: a local account can never be "opened" by RADIUS.
#
#  RADIUS is OPTIONAL. With host and secret both none, only local accounts exist.
#  If you fill only one of the two, the gateway REFUSES to start (an error now is better than half a login system).
#  The RADIUS server must list THIS machine as a "client", with the same secret.
SPOOLSTEWARD_RADIUS_HOST=none
SPOOLSTEWARD_RADIUS_PORT=1812
#  Secret shared with the RADIUS server (it is not a user password). If RADIUS does not answer, login is DENIED
#  (fail closed): nobody prints "just this once" when the check is not possible.
SPOOLSTEWARD_RADIUS_SECRET=none
#  Seconds to wait for the RADIUS answer.
SPOOLSTEWARD_RADIUS_TIMEOUT=5
#  A good RADIUS login is remembered for this many seconds, so the server is not asked at every request.
SPOOLSTEWARD_AUTH_CACHE_SECONDS=60
#  Checking a password of a local account is made to be slow and to use memory (32 MiB for a few tenths of a second, longer on a
#  Raspberry Pi). So that a burst of login attempts (or someone guessing) cannot use all the memory of a small machine, only this
#  many checks run at the same time and the others wait their turn. 3 is right for a Raspberry Pi; raise it on a big machine.
SPOOLSTEWARD_PASSWORD_CHECKS_AT_ONCE=3

#  What a PRINT CLIENT (the computer or phone that sends the job) uses to log in:
#    keys        = ONLY the personal "print keys" that each user makes in the portal (/me/keys). Recommended:
#                  the domain password is never saved on a PC or phone, and a lost key can be revoked
#                  without changing the password.
#    keys+radius = also accepts the RADIUS password (only for a transition period). Only RADIUS accounts: a local account
#                  can print only with a key. Anything that starts with "cpk-" is taken for a print key and is never
#                  sent to RADIUS (an old key on a phone must not count as a wrong domain password and lock the account),
#                  so a domain password that starts with "cpk-" can not be used for printing.
#  The password is always needed to enter the web portal.
SPOOLSTEWARD_IPP_AUTH=keys
#  Each user chooses how long a new print key lasts: 1 month, 3, 6, 1 year (suggested), 1 year and 6 months, 2 years,
#  or "one print only". These two numbers are the LONGEST choice offered, in days (the menu shows only what fits).
#  For RADIUS users it is short on purpose: to renew the key they must log in to RADIUS again in the portal, so
#  someone who leaves the company stops printing when the key expires. For local accounts it is longer.
SPOOLSTEWARD_KEY_TTL_DAYS_RADIUS=90
SPOOLSTEWARD_KEY_TTL_DAYS_LOCAL=730
#  A "one print only" key that nobody uses stops working after this many hours. After its print it is gone from the
#  list at once; for this many seconds it can still be used to ask how the job is going (phones and PCs do that).
SPOOLSTEWARD_KEY_ONCE_HOURS=24
SPOOLSTEWARD_KEY_ONCE_GRACE_SECONDS=120
#  Revoked and expired keys disappear from the list this many days after they ended. 0 = they stay for ever.
SPOOLSTEWARD_KEY_HISTORY_DAYS=14
#  Tell the owner (in the bell of the portal) a few days before a key expires. Off by default.
SPOOLSTEWARD_KEY_EXPIRY_WARN_ENABLED=false
SPOOLSTEWARD_KEY_EXPIRY_WARN_DAYS=7

#  An unknown RADIUS user who logs in to the portal is created automatically, in the default group below.
#  false = you must register users first (anyone not on the list cannot enter).
SPOOLSTEWARD_AUTO_CREATE_USERS=true
#  The group where new users go, and where users go when their group is deleted.
SPOOLSTEWARD_DEFAULT_GROUP=default

#  Prefix added to the user name that CUPS sees ("gw:mario"). It must not match a local account of the server:
#  this way a RADIUS user called "root" does not become a CUPS administrator. Do not change it without a reason.
SPOOLSTEWARD_CUPS_USER_PREFIX=gw:

#  Answer the question "what printer are you?" (Get-Printer-Attributes) without a login. Needed because
#  IPP Everywhere clients (Linux, Android, macOS) ask the printer BEFORE they have credentials. It does not allow
#  printing and does not show anybody's names or documents. Set false only if you know your clients do not need it.
SPOOLSTEWARD_ANONYMOUS_DISCOVERY=true

# =====================================================================================================================
#  3. FIRST START
# =====================================================================================================================
#
#  An emergency administrator exists, made WITHOUT a password. At the first start the gateway prints a ONE-TIME CODE
#  in the log. With it you choose the password by opening  https://<server>:8631/setup :
#       docker compose logs gateway | grep "FIRST RUN"
#  Or from a terminal:  docker compose exec -it gateway spoolsteward-admin set-admin-password
#  (there is no page open to everybody to become administrator). The code works only once.
SPOOLSTEWARD_BOOTSTRAP_ADMIN=true
SPOOLSTEWARD_BOOTSTRAP_ADMIN_USERNAME=administrator

# =====================================================================================================================
#  4. REQUESTS FOR MORE QUOTA
# =====================================================================================================================
#  When users reach their limit they can ask the portal for more jobs/pages; two different administrators must
#  approve. How many open requests one user can have at the same time, and after how many days a request
#  with no answer expires.
SPOOLSTEWARD_MAX_OPEN_REQUESTS=3
SPOOLSTEWARD_REQUEST_TTL_DAYS=14
#  true = a user must write a reason when asking for quota, a permission or a group change; false = the reason is optional.
SPOOLSTEWARD_REQUEST_REASON_REQUIRED=false

#  Advanced permissions (colour, one-sided, printers, hours) are set on the user and group pages. When a program explicitly
#  asks for colour or a one-sided print that someone may not have:
#    adjust = print it in black and white / double-sided anyway and tell the person in their bell (default)
#    refuse = refuse the job
#  Windows and Android often ask for "one-sided" or colour in EVERY job: with "refuse" their jobs are refused until the
#  person changes the option in the print dialog. A forbidden printer or an hour outside the allowed window always refuses.
SPOOLSTEWARD_PERMISSION_MODE=adjust

# =====================================================================================================================
#  5. AUDIT (the record of who printed and scanned)
# =====================================================================================================================
#  It is NEVER deleted from the portal. When the active tables grow over this many megabytes, the oldest rows
#  (outside the quota periods now running) are written to compressed files in ./data/audit-archive, CHECKED
#  (the file is read again and its sha256 sum compared) and only then removed from the database. The portal shows them
#  in the page "Audit archive": they can be read and downloaded, not deleted.
#  The folder ./data/audit-archive is on the disk of the machine (not in a volume): it is the only part you can
#  find and copy by hand. The user PUID:PGID from the file .env must be able to write in it.
SPOOLSTEWARD_AUDIT_MAX_MB=50
#  Every how many seconds to check if archiving is needed (default: every hour).
SPOOLSTEWARD_AUDIT_CHECK_INTERVAL=3600
#  HOW CAREFULLY THE DATABASE SAVES (SQLite "synchronous"). A print makes several saves (the booking, the result, the file name,
#  the last use of the key...).
#    full   = after every save the program waits until the data is really written on the disk. A power cut loses nothing that
#             was saved. On a slow disk (the SD card of a Raspberry Pi) every wait can take tens of milliseconds. (default)
#    normal = the program does not wait for the disk after every save: faster on an SD card. After a POWER CUT or a crash of the
#             whole machine (not after a crash or a restart of the program, which lose nothing) the last few seconds of saves can
#             be missing: a print just accepted could be absent from the audit and from the quotas. The database is not damaged.
#  Keep "full" unless the portal or printing feel slow on a small machine; a UPS (or a SSD) makes "normal" safe in practice.
SPOOLSTEWARD_DB_SYNC=full
#  NAMES OF THE PRINTED FILES. They are encrypted in the database (the key comes from SPOOLSTEWARD_SECRET_KEY: if you change
#  that, the names already saved can not be read any more). Administrators can stop saving new names with the
#  green/red button in the page "Print audit". Here you can also make the old ones disappear by themselves:
#  after the given number of days the name is erased, the row (who, when, pages, state) stays because quotas need it.
#  Names already written in audit archive files (see above) are not touched: those files can not be changed.
#  Default: no retention, names are kept.
SPOOLSTEWARD_JOB_TITLE_RETENTION_ENABLED=false
SPOOLSTEWARD_JOB_TITLE_RETENTION_DAYS=90

# =====================================================================================================================
#  5b. BACKUP
# =====================================================================================================================
#  The gateway can make its own backups (database, audit archive and, if encrypted, settings and certificate).
#  There are TWO levels, independent from each other:
#    * the "General" backup, set HERE: it belongs to the installation and whoever manages the server decides it;
#    * PERSONAL backups: each administrator can make as many as needed in the portal (page "Backup"), each with its
#      own folder, time and encryption. Nothing is needed in this file for them.
#  All destinations are inside ONE folder (in the container /backups, on the server ./data/backups; see BACKUP_DIR
#  in the file .env). The gateway writes nowhere else, even if an administrator types another path.
#  To save on a USB disk or a network folder (NAS, SMB, NFS): mount it ON THE SERVER inside that folder, before
#  starting the gateway, then type its sub-folder.
#
#  Encryption: the gateway writes backups at night, with nobody to type a password, so it CANNOT know the passphrase.
#  It uses a "recovery key": a pair of keys made once. The gateway keeps the part that ENCRYPTS (public); the part
#  that DECRYPTS stays locked by the passphrase, so only someone who knows it can open the files.
#  Make it with:  docker compose exec -it gateway spoolsteward-admin backup-key     (asks the passphrase, prints the key)
#  Without a key the backups are not encrypted, and for that reason they do NOT contain the secrets
#  (SECRET_KEY, TLS key, RADIUS secret).
#
#  Restore:  docker compose stop gateway mdns
#            docker compose run --rm -it --no-deps gateway spoolsteward-admin backup-restore /backups/<folder>/<file>
#            docker compose up -d
#  Check a file without restoring it:   ... spoolsteward-admin backup-verify /backups/<folder>/<file>
#  Run by hand:                         docker compose exec gateway spoolsteward-admin backup-run
SPOOLSTEWARD_BACKUP_ENABLED=false
#  Sub-folder (inside the backup folder) of the General backup.
SPOOLSTEWARD_BACKUP_DIR=general
#  true = write only if the file .spoolsteward-destination exists in that folder. Use it when the folder is a network or USB disk:
#  an unmounted disk then makes the backup fail (visible in red) instead of filling the server disk. Make the file once, while
#  the disk is mounted:  touch data/backups/<folder>/.spoolsteward-destination
SPOOLSTEWARD_BACKUP_REQUIRE_MARKER=false
#  Local hour (0-23) of the daily backup. If the gateway was off at that hour, it runs as soon as it starts again.
SPOOLSTEWARD_BACKUP_HOUR=3
#  How many copies to keep: the last one of each of the last N days / weeks / months. The others are deleted,
#  but only after the new one was written and read back successfully. It applies only to files of THIS gateway.
SPOOLSTEWARD_BACKUP_KEEP_DAILY=7
SPOOLSTEWARD_BACKUP_KEEP_WEEKLY=4
SPOOLSTEWARD_BACKUP_KEEP_MONTHLY=12
#  Recovery key (made by backup-key), looks like cpgbk1.xxxx.yyyy. none = not encrypted and without secrets.
SPOOLSTEWARD_BACKUP_RECIPIENT=none

# =====================================================================================================================
#  5c. UPDATES
# =====================================================================================================================
#  Once a day the gateway asks GitHub for the list of releases and, if one is newer than the one installed, shows a
#  note to administrators in the portal. Nothing is updated by itself. Only this one request goes out: it sends no
#  data about your server, users or printers. false = never ask (then look at the releases page yourself).
#  To update: the Update box of the portal's Backups page, or  scripts/update.sh  on the server (see docs/en/installation.md).
SPOOLSTEWARD_UPDATE_CHECK=true
#  true = betas (GitHub pre-releases) are offered like final releases, with one more confirmation; false = final releases only.
SPOOLSTEWARD_UPDATE_BETA=true
#  The GitHub repository (owner/name) whose releases are checked and installed. Change it only for a fork.
SPOOLSTEWARD_UPDATE_REPOSITORY=deh-aleh/SpoolSteward

# =====================================================================================================================
#  6. PRINTING AND SCANNING
# =====================================================================================================================
#  Printing from the portal (phones): biggest file size and most copies per job.
SPOOLSTEWARD_WEB_UPLOAD_MB=25
SPOOLSTEWARD_WEB_MAX_COPIES=20
#  An IPP job (document included) bigger than this is refused.
SPOOLSTEWARD_MAX_REQUEST_MB=200

#  Every how many seconds the gateway compares its jobs with CUPS to learn if they finished, failed or were cancelled
#  (this is how quotas and real page counts are corrected). If it cannot reach CUPS, "reconcile:" appears in the log.
SPOOLSTEWARD_RECONCILE_INTERVAL=30

#  SCANNING (eSCL). Scanners are found BY THEMSELVES: every connected printer that speaks eSCL appears in the portal
#  (/me/scan) and disappears within ~30 seconds if unplugged. The image already has the value for ipp-usb:
#       SPOOLSTEWARD_SCAN_URL=http://ipp-usb:60000
#  Write it here only to ADD scanners that are not found by themselves (network printers with eSCL on an unusual
#  port). Format: name=address, separated by commas. none = scanning is off.
#SPOOLSTEWARD_SCAN_URL=http://ipp-usb:60000,office=https://192.168.1.50:443
#  Most seconds for one scan (a page from the glass can be slow).
SPOOLSTEWARD_SCAN_TIMEOUT=180
#  A scan made in the portal waits IN MEMORY until the person downloads it. Together, all the people can keep this many megabytes
#  of finished scans (a colour page at 300 dpi is about 1 MB). When a new scan does not fit, the OLDEST finished ones are
#  dropped from memory first; the newest is always kept, even if it alone is bigger than this.
SPOOLSTEWARD_SCAN_KEEP_MB=50
#  Minutes a finished scan is kept in memory. After this it is gone and the scan must be done again.
SPOOLSTEWARD_SCAN_KEEP_MINUTES=10
#  true = a scan leaves the memory, and the list of the portal, as soon as its download has finished (it can be downloaded once).
#  false = it stays until the minutes above are over, so it can be downloaded again.
SPOOLSTEWARD_SCAN_DELETE_AFTER_DOWNLOAD=false
#  Accept scans from eSCL clients that CANNOT send credentials (for example NAPS2). Those scans are credited to the
#  account named below, together with the IP address of the sender. Leave false unless your network is trusted.
SPOOLSTEWARD_ESCL_ANONYMOUS=false
#  The name of that account. It is created by itself: a local account with no password, nobody can sign in with it.
#  If an account with this name ALREADY exists and is a real one (it has a password, comes from RADIUS, or is an
#  administrator), it is never used: scans without login are refused, the administrators get a notice in the bell and the
#  log says why. Then choose another name here. Lower-case letters, digits, dot, dash, underscore; up to 63.
SPOOLSTEWARD_ESCL_GUEST_USERNAME=unknown-guest
#  Scan window: a button on /me/scan lets a person say "my scan app is about to scan". For the time below (plus the scan
#  itself) scan requests WITHOUT credentials that come from the same IP address as that person's browser are accepted and
#  credited to that person (their quotas and permissions apply). Any other address is refused, the audit records both
#  addresses and the person is told in the bell. It also works with SPOOLSTEWARD_ESCL_ANONYMOUS=true (the scan is then credited
#  to the person instead of the guest account). false = no button at all. Limits (NAT, IPv4/IPv6, proxies): user guide,
#  "Scanning from an app that cannot sign in".
SPOOLSTEWARD_ESCL_WINDOW=true
#  How long the window stays open, in seconds: 60 to 900 (a scan that has started is finished even if the time ends).
#  Any other value stops the portal at start: `docker compose logs gateway` says why.
SPOOLSTEWARD_ESCL_WINDOW_SECONDS=180

# =====================================================================================================================
#  6b. USB PRINTERS: AUTOMATIC DISCOVERY AND REMOVAL
# =====================================================================================================================
#  When you plug in a USB printer the gateway makes its queue in CUPS by itself (within ~1 minute). Two ways, in this order:
#    1) ipp-usb: if the printer has IPP-over-USB (almost all recent ones) the ipp-usb container serves it and the queue uses
#       ipp://ipp-usb:<port>/ipp/print (no driver needed);
#    2) direct use by CUPS (usb://...): for printers without IPP-over-USB (many older lasers). It needs a driver CUPS
#       knows (the image has brlaser, gutenprint, splix, foo2zjs; add others in docker/stack/Dockerfile).
#       A printer served by ipp-usb is never taken this way.
SPOOLSTEWARD_AUTO_DISCOVER=true
#  Every how many seconds to look (and to check which USB printers do not answer).
SPOOLSTEWARD_DISCOVERY_INTERVAL=30
#  Where the ipp-usb bridge is and which ports it gives to printers (see docker/stack/ipp-usb/ipp-usb.conf). none = do not look there.
SPOOLSTEWARD_USB_BRIDGE_HOST=ipp-usb
SPOOLSTEWARD_USB_BRIDGE_PORTS=60000-60099
#  false = do not look for USB printers without IPP-over-USB (CUPS does not touch the USB bus).
SPOOLSTEWARD_USB_DIRECT=true
#  A USB queue whose device has not answered for this many hours is removed by itself (the Printers page shows a
#  countdown, and the button "Delete queue" removes it at once). 0 = never. Network queues (IPP/socket printers)
#  are never removed by themselves: a printer switched off for the weekend must come back as it was.
SPOOLSTEWARD_OFFLINE_REMOVE_HOURS=8

#  Printers page: for how many seconds the data read from the printers is reused, and every how many seconds the page reloads
#  by itself when the administrator turns on the switch "Auto refresh" (remembered per browser; starts off).
#  0 (or a value that is not valid) = the default, 15. Smallest 5, biggest 3600. The lower it is, the more often printers are asked.
SPOOLSTEWARD_PRINTERS_REFRESH_SECONDS=15

# =====================================================================================================================
#  7. NETWORK AND ANNOUNCEMENT (mDNS / Bonjour)
# =====================================================================================================================
#  Public address of the portal, used in messages ("ask for more quota at https://..."). If none it is taken from
#  the request, but for messages shown by the print client it is better to write it here.
SPOOLSTEWARD_PORTAL_URL=none
#  Name that the announcer publishes (it must be one of the names inside the TLS certificate, or clients refuse to
#  connect). none = the host part of PORTAL_URL, otherwise the machine name.
SPOOLSTEWARD_MDNS_HOSTNAME=none
#  IPv4 addresses to announce, separated by commas. none = the one of the default route. Needed if the machine
#  has several network cards and the right one is not the first.
SPOOLSTEWARD_MDNS_ADDRESSES=none
#  Every how many seconds the announcer checks the list of queues (an unplugged device or a hidden printer
#  disappears from the network within this time).
SPOOLSTEWARD_MDNS_INTERVAL=30
#  Behind a reverse proxy that ends the TLS: write "ipps". Otherwise leave it out or write none (it is guessed from the request).
#SPOOLSTEWARD_PUBLIC_SCHEME=ipps

# =====================================================================================================================
#  7b. TLS CERTIFICATE: WARNINGS IN THE PORTAL (bell)
# =====================================================================================================================
#  The gateway only LOOKS at the certificate in config/tls; scripts/cert-sync.sh (run by cron) is what renews it.
#  Always on: "the certificate has expired" and "the last run of cert-sync.sh failed".
#  "The address announced on the network is not in the certificate" can be turned off here:
SPOOLSTEWARD_CERT_NAME_CHECK=true
#  A warning before the certificate expires. OFF by default, because a renewal that is simply not due yet would look like
#  a problem. Let's Encrypt renews about 30 days before the end, so a value below 30 (default 14) means "the renewal
#  has been failing for a while". Turn it on if you want to be told early:
SPOOLSTEWARD_CERT_EXPIRY_WARN_ENABLED=false
SPOOLSTEWARD_CERT_EXPIRY_WARN_DAYS=14

# =====================================================================================================================
#  8. OTHER
# =====================================================================================================================
#  Time zone for the weekly/monthly quota periods, for the times shown in the portal and for the times in the logs
#  (docker compose logs). CHANGE IT to yours,
#  for example Europe/Rome, America/New_York. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
SPOOLSTEWARD_TIMEZONE=UTC
#  Portal language for browsers that do not tell their language, and for users who chose none: en, it, es, ru, zh.
#  Each user can choose their own in "Settings"; with no choice the browser language is used.
SPOOLSTEWARD_LANGUAGE=en
#  DEBUG, INFO, WARNING, ERROR.
SPOOLSTEWARD_LOG_LEVEL=INFO
#  HTTPS ONLY (HSTS). On every HTTPS answer the portal tells the browser "for this many seconds, use only HTTPS with this host name".
#  What it does, and when:
#   * It is stored only if the browser TRUSTS the certificate (a certificate from a real authority, or the company CA / the
#     certificate installed on the computer, docs/en/certificates.md). With the self-signed certificate of scripts/docker-init.sh
#     that you click through at the browser's warning, the browser ignores it: nothing changes and nothing is protected.
#   * Once stored, an address typed or linked as http:// is turned into https:// by the browser itself, and a certificate error
#     can no longer be clicked through ("Advanced - continue" is gone) while the certificate is wrong (expired, replaced by one
#     the browser does not trust). It works again as soon as the certificate is right.
#   * It is per HOST NAME, not per port: another service on the same name that speaks only plain http (for example a second web page
#     of the same Raspberry on another port) is also pushed to https by that browser and stops opening.
#  OFF by default (0 = never sent). Turn it on only with a certificate the browsers trust: 2592000 (30 days) to start, 31536000 (one year)
#  once it has worked for a while. Then run: docker compose up -d
SPOOLSTEWARD_HSTS_SECONDS=0
#  What http://<server>:8631/healthz shows besides the status. It needs NO login, so anyone who can reach the port can read it:
#  the default is the status only ({"status":"ok"}, or "degraded" with a 503). Add what you want, separated by commas:
#    version   the version of SpoolSteward that runs (for example "0.1.0")
#    printers  how many queues there are: {"usb": 1, "network": 2, "virtual": 0, "total": 3}
#              usb = a USB printer (through the ipp-usb container or CUPS' own usb backend); network = IPP/socket printers;
#              virtual = test queues that write PDF files. Only counts, never names.
#  Example: SPOOLSTEWARD_HEALTHZ_INFO=version,printers      none (default) = status only. More items may be added in the future.
SPOOLSTEWARD_HEALTHZ_INFO=none
#  The bell in the portal (administrators) and the log report the same notice from the same source only once in a while, so
#  a client that retries 100 times does not flood them. The wait depends on SPOOLSTEWARD_LOG_LEVEL:
#  DEBUG 1 minute, INFO 1 day, WARNING 3 days, ERROR 7 days. Set a number of seconds here to use your own wait. 0 = by log level.
SPOOLSTEWARD_NOTICE_INTERVAL=0
#  Printer problems: the gateway looks at every physical printer once a minute. A paper jam, no paper, or no ink/toner
#  (and, for administrators only, ink running low) appears in the administrators' bell and closes by itself when it is solved.
#  true  = the people who have a print WAITING on that printer are told too, in their own bell (only them, not everybody).
#  false = only the administrators are told.
SPOOLSTEWARD_PRINTER_ALERTS_USERS=true

# =====================================================================================================================
#  DO NOT SET HERE (already decided by the image and by docker-compose.yml)
# =====================================================================================================================
#  SPOOLSTEWARD_TLS_CERTFILE / SPOOLSTEWARD_TLS_KEYFILE  -> /tls/fullchain.pem and /tls/privkey.pem (folder config/tls).
#                                              Without TLS the gateway refuses to start.
#  SPOOLSTEWARD_DATABASE_URL                       -> sqlite:////data/spoolsteward.db (volume "portal-data"). Only SQLite works:
#                                              any other kind of database is refused at start.
#  SPOOLSTEWARD_CUPS_URL                           -> unix:///run/cups/cups.sock (private socket).
#  SPOOLSTEWARD_ALLOW_INSECURE_AUTH                -> never in production: it would send passwords in clear text over HTTP.
#
#  Part A of this file (PUID/PGID, PORTAL_PORT, CUPS_QUEUES, BACKUP_DIR, SPOOLSTEWARD_REGISTRY, SPOOLSTEWARD_VERSION) is read by
#  docker compose itself.
